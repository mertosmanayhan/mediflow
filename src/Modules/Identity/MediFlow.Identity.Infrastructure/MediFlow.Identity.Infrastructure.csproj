<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      BCrypt: şifre hash'leme. KASITLI OLARAK YAVAŞ bir algoritma
      ("adaptive hash"): iş faktörü artırılarak donanım hızlandıkça
      yavaşlatılabilir. SHA-256 gibi hızlı hash'ler şifre için YANLIŞ
      tercihtir - hızlı olmaları kaba kuvvet saldırısını kolaylaştırır.
    -->
