<Project Sdk="Microsoft.NET.Sdk">

  <!--
    İş akışları (use case) katmanı.

    Domain'i BİLİR, Domain onu bilmez. Ok tek yönlü:
        Application  ───►  Domain

    Burada da NuGet paketi yok. Veritabanı, HTTP, JSON hâlâ uzakta -
    bu katman sadece "hangi adım hangi sırayla yapılır"ı bilir.
  -->

  <ItemGroup>
    <!--
      Handler'lar 'internal': dışarıdan kimse onları doğrudan çağırmasın,
      komut gönderilsin. Ama testlerin onlara erişmesi gerekiyor.

      InternalsVisibleTo, SADECE adı verilen assembly'ye internal tipleri
      açar. Alternatif handler'ları public yapmaktı - o zaman üretim
      kodunda da erişilebilir olurlardı ve kapsülleme kararı delinirdi.

      Yani: üretimde kapalı, testte açık.
    -->
    <InternalsVisibleTo Include="MediFlow.PatientProfile.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediFlow.PatientProfile.Domain\MediFlow.PatientProfile.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
