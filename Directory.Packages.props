<!--
  ============================================================
   Directory.Packages.props — NuGet sürümlerinin TEK kaynağı
   (Central Package Management / CPM)
  ============================================================

   NASIL ÇALIŞIR?
   ManagePackageVersionsCentrally açıkken:
     - Sürümler burada <PackageVersion> ile tanımlanır
     - .csproj dosyaları sadece <PackageReference Include="..." />
       yazar, SÜRÜM YAZMAZ
     - Bir .csproj yine de Version yazarsa NuGet NU1008 hatası
       verir -> kural tavsiye değil, zorunlu

   NEDEN?
   9 servis x 10 paket = 90 sürüm numarasını elle senkron tutmak
   imkansız. Aynı paketin iki serviste farklı sürümde olması,
   çalışma zamanında teşhisi çok zor hatalar üretir.

   BONUS: Dependabot güncelleme PR'ı 9 dosya yerine tek dosyayı
   değiştirir -> diff okunabilir kalır.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- ==========================================================
       TEST
       ========================================================== -->
  <ItemGroup Label="Test">
    <!-- Test host'u: 'dotnet test' komutunun altyapısı -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Test framework'ü: [Fact], [Theory], Assert -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- Adaptör: test host'unun xUnit testlerini bulmasını sağlar -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Kod kapsama ölçümü. Faz 6'da CI'da eşik koyacağız. -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
  <!-- ==========================================================
       UYGULAMA KATMANI — iş akışı altyapısı
       ========================================================== -->
  <ItemGroup Label="Application">
    <!--
      Mediator: isteği gönderen ile işleyen arasındaki doğrudan
      bağımlılığı keser, ayrıca pipeline behavior altyapısını verir.

      LİSANS NOTU: MediatR 13'ten itibaren ticari lisansa geçti
      (küçük ölçek için ücretsiz katman var). Ücretsiz alternatifler:
      Wolverine, FastEndpoints veya kendi dispatcher'ını yazmak.
      İş ilanlarındaki yaygınlığı için bu seçildi.
    -->
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <!-- Girdi doğrulaması: isteğin ŞEKLİ doğru mu?
         (İş kuralları Domain'de kalır, buraya taşınmaz.) -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!--
      Loglama ARAYÜZLERİ (ILogger<T>). Dikkat: ".Abstractions" paketi.

      Application katmanına paket eklemek normalde şüpheyle bakılır, ama
      "*.Abstractions" paketleri sadece ARAYÜZ içerir, implementasyon
      içermez. Yani bu referans "nasıl loglanacağına" değil, "loglama
      diye bir şey var"a bağımlılık. Hangi log sağlayıcısının kullanıldığı
      (Blok 2'de Serilog olacak) Api katmanında kararlaştırılır.

      Bu ayrım, Domain'in IPatientRepository'yi tanıyıp EF Core'u
      tanımamasıyla aynı mantık.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <!-- ==========================================================
       VERİ ERİŞİMİ
       ========================================================== -->
  <ItemGroup Label="Data">
    <!-- EF Core'un SQL Server sağlayıcısı: LINQ sorgularını T-SQL'e çevirir -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!--
      Migration üretmek için gereken TASARIM ZAMANI paketi.
      Sadece 'dotnet ef' komutları çalışırken kullanılır; uygulamayla
      birlikte DAĞITILMAZ. Bunu sağlayan PrivateAssets/IncludeAssets
      ayarları Api projesinin .csproj'sinde - buraya değil oraya ait,
      çünkü "hangi proje nasıl kullanıyor" bilgisi projeye özeldir.
      ('dotnet add package' ikisine de yazmıştı, buradakini temizledik.)
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>
  <!-- ==========================================================
       WEB / API
       NOT: 'dotnet add package' eklediği satırları alfabetik sıraya
       göre ilk ItemGroup'un (Test) İÇİNE koyuyor. Araç dosyanın
       anlamını bilmiyor, sadece sıralıyor - gruplamayı elle düzeltiyoruz.
       ========================================================== -->
  <ItemGroup Label="Web">
    <!-- API'nin kendini tanımlayan OpenAPI belgesini üretmesi için -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- O belgeyi tarayıcıda gezilebilir arayüze çeviren araç -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.14" />
    <!-- Yapılandırılmış loglama: Serilog + Seq sink'i.
         Hangi log sağlayıcısının kullanıldığı bir HOST kararı, o yüzden
         bu paketler Api katmanında. Application sadece ILogger arayüzünü
         tanıyor, Serilog'u tanımıyor. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>
  <!-- ==========================================================
       Sonraki fazlarda buraya eklenecekler (henüz kullanılmıyor,
       YAGNI - ihtiyaç doğmadan paket eklemiyoruz):

       Faz 1: MediatR, FluentValidation, Serilog, EF Core, JWT
       Faz 2: StackExchange.Redis, Yarp.ReverseProxy
       Faz 3: MassTransit.RabbitMQ, MongoDB.Driver
       Faz 5: OpenTelemetry.*, prometheus-net
       Faz 6: Testcontainers, NSubstitute, NetArchTest
       ========================================================== -->
</Project>