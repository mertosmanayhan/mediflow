# ============================================================
#  ŞABLON DOSYA — bu dosya repoda, gerçek değerler DEĞİL
#
#  KURULUM:
#    1) Bu dosyayı .env olarak kopyala:
#         Windows:  Copy-Item .env.example .env
#         Linux:    cp .env.example .env
#    2) Değerleri kendi ortamına göre değiştir
#
#  .env dosyası .gitignore'da -> asla commit edilmez.
#  Bir kez commit edilen sır, sonradan silinse bile Git
#  geçmişinde sonsuza kadar kalır ve botlar public repo'ları
#  tarayarak bulur.
# ============================================================

# ------------------------------------------------------------
#  MSSQL
#
#  SQL Server şifre kuralları (yoksa container AÇILMAZ ve
#  loglarda "Password validation failed" yazar):
#    - en az 8 karakter
#    - büyük harf + küçük harf + rakam + sembol
# ------------------------------------------------------------
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# ------------------------------------------------------------
#  RabbitMQ
#  Yönetim arayüzü girişinde de bu bilgiler kullanılır:
#  http://localhost:15672
# ------------------------------------------------------------
RABBITMQ_USER=mediflow
RABBITMQ_PASSWORD=mediflow

# ------------------------------------------------------------
#  Seq (log sunucusu)
#
#  Seq 2026.1'den itibaren ilk çalıştırmada admin şifresi ZORUNLU.
#  Verilmezse container açılmaz ve loglarda şunu yazar:
#    "No default admin password was supplied"
#
#  Giriş: http://localhost:5341  ->  kullanıcı adı 'admin'
#
#  DİKKAT: Bu değer sadece İLK çalıştırmada (veri boşken) okunur.
#  Sonradan değiştirmek için: docker compose down -v
# ------------------------------------------------------------
SEQ_ADMIN_PASSWORD=ChangeMe_Str0ng!Pass
